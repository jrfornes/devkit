{
  "name": "@agentic-ui-dev/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentic-ui-harness": "./run-mcp.mjs"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; import path from 'node:path'; const p = path.resolve('dist/index.js'); fs.accessSync(p); console.log('Wrote', p);\"",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "start": "node run-mcp.mjs",
    "dev": "node run-mcp.mjs",
    "acceptance": "tsx scripts/acceptance-test.ts",
    "acceptance:eyes": "tsx scripts/acceptance-eyes-test.ts",
    "acceptance:ship": "tsx scripts/acceptance-ship-test.ts",
    "acceptance:skills": "tsx scripts/acceptance-skills-test.ts",
    "acceptance:rung1": "tsx scripts/acceptance-rung1-test.ts",
    "reset-specimen": "tsx scripts/reset-specimen.ts",
    "print-config": "tsx scripts/print-config.ts",
    "test:config": "tsx scripts/config-split-test.ts",
    "baseline:generate": "tsx scripts/generate-visual-baseline.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.51.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
